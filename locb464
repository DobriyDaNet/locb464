local function FindTabContainer(tab)
    for _, d in ipairs(tab:GetDescendants()) do
        if d:IsA("Frame") and not d:IsA("ScrollingFrame")
            and d.Name ~= "Topbar" and d.Size.Y.Scale > 0.5 then
            return d
        end
    end
    return nil
end

